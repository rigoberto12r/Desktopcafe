<UserControl
    x:Class="Desktopcafe.Agent.Views.GameBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid Padding="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
      <TextBlock Text="Juegos" FontSize="28" FontWeight="SemiBold" />
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Buscar juego..." Width="250"
                       QueryIcon="Find" TextChanged="SearchBox_TextChanged" />
    </StackPanel>

    <GridView Grid.Row="1" x:Name="GamesGrid" IsItemClickEnabled="True" ItemClick="Game_Click">
      <GridView.ItemTemplate>
        <DataTemplate>
          <Border
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              CornerRadius="8"
              Width="200" Height="160"
              Padding="16">
            <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
              <FontIcon Glyph="&#xE7FC;" FontSize="32" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextAlignment="Center"
                         TextTrimming="CharacterEllipsis" MaxLines="2" />
              <TextBlock Text="{Binding Category}" FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         TextAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</UserControl>
