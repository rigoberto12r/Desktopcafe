<UserControl
    x:Class="Desktopcafe.Agent.Views.SessionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="320">

  <Border
      Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
      CornerRadius="12"
      Padding="16"
      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
      BorderThickness="1"
      Shadow="{ThemeResource SharedMediumShadow}">

    <StackPanel Spacing="12">
      <!-- Header -->
      <Grid>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE7F4;" FontSize="16" />
          <TextBlock x:Name="ComputerNameText" Text="Desktopcafe - PC01" FontWeight="SemiBold" />
        </StackPanel>
        <Button HorizontalAlignment="Right" Click="ToggleExpand_Click" Padding="4">
          <FontIcon x:Name="ExpandIcon" Glyph="&#xE70D;" FontSize="12" />
        </Button>
      </Grid>

      <!-- Compact view -->
      <Grid x:Name="CompactView">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <FontIcon Glyph="&#xE916;" FontSize="14" />
            <TextBlock x:Name="TimeCompactText" Text="01:23:45" FontWeight="Bold" FontSize="16" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <FontIcon Glyph="&#xE7BF;" FontSize="14" />
            <TextBlock x:Name="ChargeCompactText" Text="$20.00" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Expanded view -->
      <StackPanel x:Name="ExpandedView" Visibility="Collapsed" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE916;" FontSize="16" />
          <TextBlock Text="Tiempo restante:" />
          <TextBlock x:Name="TimeExpandedText" Text="01:23:45" FontWeight="Bold" FontSize="20" />
        </StackPanel>

        <ProgressBar x:Name="SessionProgress" Value="70" Maximum="100" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE77B;" FontSize="14" />
          <TextBlock x:Name="ClientNameText" Text="Juan Garcia" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE7BF;" FontSize="14" />
          <TextBlock Text="Total:" />
          <TextBlock x:Name="ChargeExpandedText" Text="$20.00" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon Glyph="&#xE749;" FontSize="14" />
          <TextBlock x:Name="PrintInfoText" Text="Impresiones: 0 paginas ($0.00)" />
        </StackPanel>

        <Button Content="Solicitar mas tiempo" HorizontalAlignment="Stretch" Click="RequestExtend_Click" />
        <Button Content="Llamar al admin" HorizontalAlignment="Stretch" Click="CallAdmin_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
