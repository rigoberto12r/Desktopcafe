<Window
    x:Class="Desktopcafe.Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Desktopcafe.Agent.Views"
    Title="Desktopcafe Agent">

  <Grid>
    <!-- Lock Screen (shown by default) -->
    <views:LockScreenPage x:Name="LockScreen" Visibility="Visible" />

    <!-- Session Overlay (shown when session active) -->
    <views:SessionOverlay x:Name="SessionOverlay" Visibility="Collapsed"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           Margin="16" />
  </Grid>
</Window>
