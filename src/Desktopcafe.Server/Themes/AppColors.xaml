<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Accent Colors -->
  <Color x:Key="AccentPrimary">#0078D4</Color>
  <Color x:Key="AccentSecondary">#005A9E</Color>

  <!-- Status Colors -->
  <Color x:Key="StatusAvailable">#0F7B0F</Color>
  <Color x:Key="StatusInUse">#0078D4</Color>
  <Color x:Key="StatusWarning">#9D5D00</Color>
  <Color x:Key="StatusError">#C42B1C</Color>
  <Color x:Key="StatusMaintenance">#767676</Color>
  <Color x:Key="StatusOffline">#444444</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="StatusAvailableBrush" Color="{StaticResource StatusAvailable}" />
  <SolidColorBrush x:Key="StatusInUseBrush" Color="{StaticResource StatusInUse}" />
  <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}" />
  <SolidColorBrush x:Key="StatusErrorBrush" Color="{StaticResource StatusError}" />
  <SolidColorBrush x:Key="StatusMaintenanceBrush" Color="{StaticResource StatusMaintenance}" />
  <SolidColorBrush x:Key="StatusOfflineBrush" Color="{StaticResource StatusOffline}" />

  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimary}" />

</ResourceDictionary>
