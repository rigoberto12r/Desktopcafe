<Page
    x:Class="Desktopcafe.Server.Views.PrinterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

  <ScrollViewer Padding="32">
    <StackPanel Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="Impresiones" Style="{StaticResource PageHeaderStyle}" />
        <Button Content="Actualizar" Click="Refresh_Click">
          <Button.Icon><FontIcon Glyph="&#xE72C;" /></Button.Icon>
        </Button>
      </StackPanel>

      <!-- Pending Jobs -->
      <TextBlock Text="Trabajos Pendientes" Style="{StaticResource SectionHeaderStyle}" />
      <ListView x:Name="PendingList" SelectionMode="None">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource KpiCardStyle}" Margin="0,4">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ComputerName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DocumentName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding PagesText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding ColorText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CostText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource StatusWarningBrush}" />

                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                  <Button ToolTipService.ToolTip="Aprobar" Tag="{Binding Id}" Click="Approve_Click"
                          Background="{StaticResource StatusAvailableBrush}">
                    <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="White" />
                  </Button>
                  <Button ToolTipService.ToolTip="Rechazar" Tag="{Binding Id}" Click="Reject_Click"
                          Background="{StaticResource StatusErrorBrush}">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="White" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <!-- Completed Jobs -->
      <TextBlock Text="Trabajos Completados" Style="{StaticResource SectionHeaderStyle}" />
      <ListView x:Name="CompletedList" SelectionMode="None" MaxHeight="400">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource KpiCardStyle}" Margin="0,4" Opacity="0.7">
              <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="80" />
                  <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ComputerName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding DocumentName}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding PagesText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding ColorText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding CostText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding StatusText}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </StackPanel>
  </ScrollViewer>
</Page>
