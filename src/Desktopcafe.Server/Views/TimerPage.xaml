<Page
    x:Class="Desktopcafe.Server.Views.TimerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

  <Grid Padding="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
      <TextBlock Text="Control de Sesiones" Style="{StaticResource PageHeaderStyle}" />
      <Button x:Name="NewSessionBtn" Content="Nueva Sesion" Style="{StaticResource AccentButtonStyle}" Click="NewSession_Click">
        <Button.Icon><FontIcon Glyph="&#xE710;" /></Button.Icon>
      </Button>
    </StackPanel>

    <ListView Grid.Row="1" x:Name="SessionList" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource KpiCardStyle}" Margin="0,4">
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding ComputerName}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Text="{Binding ClientName}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
              </StackPanel>

              <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="{Binding TimeRemainingText}" FontSize="28" FontWeight="Bold"
                           Foreground="{Binding StatusColor}" HorizontalAlignment="Center" />
                <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,4,0,0" />
              </StackPanel>

              <TextBlock Grid.Column="2" Text="{Binding SessionTypeText}" VerticalAlignment="Center" />

              <TextBlock Grid.Column="3" Text="{Binding TotalChargeText}" FontWeight="SemiBold"
                         VerticalAlignment="Center" />

              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4">
                <Button ToolTipService.ToolTip="Extender" Tag="{Binding Id}" Click="Extend_Click">
                  <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Pausar/Reanudar" Tag="{Binding Id}" Click="PauseResume_Click">
                  <FontIcon Glyph="&#xE769;" FontSize="14" />
                </Button>
                <Button ToolTipService.ToolTip="Terminar" Tag="{Binding Id}" Click="EndSession_Click">
                  <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{StaticResource StatusErrorBrush}" />
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
