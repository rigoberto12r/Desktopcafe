<Page
    x:Class="Desktopcafe.Server.Views.ComputerMapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

  <Grid Padding="32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
      <TextBlock Text="Mapa de Computadoras" Style="{StaticResource PageHeaderStyle}" />
      <Button Content="Agregar PC" Click="AddComputer_Click">
        <Button.Icon><FontIcon Glyph="&#xE710;" /></Button.Icon>
      </Button>
      <Button Content="Actualizar" Click="Refresh_Click">
        <Button.Icon><FontIcon Glyph="&#xE72C;" /></Button.Icon>
      </Button>
    </StackPanel>

    <GridView
        Grid.Row="1"
        x:Name="ComputerGrid"
        IsItemClickEnabled="True"
        ItemClick="ComputerGrid_ItemClick"
        SelectionMode="None">
      <GridView.ItemTemplate>
        <DataTemplate>
          <Border
              Style="{StaticResource ComputerCardBaseStyle}"
              Width="200" Height="180"
              PointerEntered="Card_PointerEntered"
              PointerExited="Card_PointerExited">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7F4;" FontSize="16" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" />
              </StackPanel>
              <Border Height="3" CornerRadius="2" Background="{Binding StatusColor}" />
              <TextBlock Text="{Binding StatusText}" FontSize="14" />
              <TextBlock Text="{Binding TimeRemainingText}"
                         FontSize="20" FontWeight="Bold"
                         Visibility="{Binding HasActiveSession}" />
              <TextBlock Text="{Binding ClientName}"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         FontSize="12"
                         Visibility="{Binding HasActiveSession}" />
              <ProgressBar Value="{Binding Progress}" Maximum="100"
                           Visibility="{Binding HasActiveSession}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </GridView.ItemTemplate>
    </GridView>
  </Grid>
</Page>
