<Page
    x:Class="Desktopcafe.Server.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

  <ScrollViewer Padding="32">
    <StackPanel Spacing="16" MaxWidth="600" HorizontalAlignment="Left">
      <TextBlock Text="Configuracion" Style="{StaticResource PageHeaderStyle}" />

      <!-- General -->
      <Border Style="{StaticResource KpiCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />
          <TextBox x:Name="CafeNameBox" Header="Nombre del Cafe" />
          <TextBox x:Name="LockScreenMessageBox" Header="Mensaje de Pantalla de Bloqueo"
                   TextWrapping="Wrap" AcceptsReturn="True" Height="80" />
        </StackPanel>
      </Border>

      <!-- Printing Prices -->
      <Border Style="{StaticResource KpiCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Precios de Impresion" Style="{StaticResource SectionHeaderStyle}" />
          <NumberBox x:Name="PrintPriceBWBox" Header="Precio B/N por pagina ($)" Minimum="0"
                     SpinButtonPlacementMode="Compact" />
          <NumberBox x:Name="PrintPriceColorBox" Header="Precio Color por pagina ($)" Minimum="0"
                     SpinButtonPlacementMode="Compact" />
        </StackPanel>
      </Border>

      <!-- Warning Minutes -->
      <Border Style="{StaticResource KpiCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Alertas de Tiempo" Style="{StaticResource SectionHeaderStyle}" />
          <NumberBox x:Name="WarningMinutes1Box" Header="Alerta 1 (minutos antes)" Minimum="1"
                     SpinButtonPlacementMode="Compact" />
          <NumberBox x:Name="WarningMinutes2Box" Header="Alerta 2 (minutos antes)" Minimum="1"
                     SpinButtonPlacementMode="Compact" />
          <NumberBox x:Name="WarningMinutes3Box" Header="Alerta 3 (minutos antes)" Minimum="1"
                     SpinButtonPlacementMode="Compact" />
        </StackPanel>
      </Border>

      <!-- Backup -->
      <Border Style="{StaticResource KpiCardStyle}">
        <StackPanel Spacing="12">
          <TextBlock Text="Respaldo" Style="{StaticResource SectionHeaderStyle}" />
          <ToggleSwitch x:Name="AutoBackupToggle" Header="Respaldo Automatico"
                        OnContent="Activado" OffContent="Desactivado" />
        </StackPanel>
      </Border>

      <!-- Save Button -->
      <Button Content="Guardar Configuracion" Style="{StaticResource AccentButtonStyle}"
              HorizontalAlignment="Stretch" Click="Save_Click" Margin="0,8,0,32">
        <Button.Icon><FontIcon Glyph="&#xE74E;" /></Button.Icon>
      </Button>
    </StackPanel>
  </ScrollViewer>
</Page>
